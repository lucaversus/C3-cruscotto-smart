	(text "MICROSD (FACOLTATIVA), SPI COME IL LOGGER" (exclude_from_sim no) (at 215.9 45.72 0) (effects (font (size 2.0 2.0)) (justify left bottom)) (uuid "7e0d47f0-1de6-5b9a-91b1-4d326757ee70"))
	(text "RESISTENZE DI PULL-UP DELLA MICROSD" (exclude_from_sim no) (at 215.9 106.68 0) (effects (font (size 1.5 1.5)) (justify left bottom)) (uuid "bdd8b443-0bb6-5ba4-97d0-ec39e2896c9a"))
	(text "Proposta preliminare, non verificata. Pull-up I2C sul foglio del front-end. Piedinatura del modulo IMU da riscontrare sulla serigrafia all’arrivo (HW-IMU-LSM6DSO)." (exclude_from_sim no) (at 25.4 236.22 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "85175b1b-3ee4-53b8-b375-7189c8e4af69"))
	(text "IMU e RTC sul 3,3 V sempre acceso (consumi a riposo di pochi uA); MicroSD sul 3,3 V acceso a quadro. Pila dell’RTC non ricaricata (D-019)." (exclude_from_sim no) (at 25.4 241.3 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "6dcd1818-7a05-593f-9839-7b61406dde76"))
	(text "Etichette con lo stesso nome sono collegate, anche tra fogli diversi." (exclude_from_sim no) (at 25.4 246.38 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "7c2f4c17-6312-53f9-85cc-2c0c52f20bef"))
